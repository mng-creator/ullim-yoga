---
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props { title?: string; description?: string; }
const {
  title = '울림요가 | 성남 모란 요가 · 사운드배스',
  description = '성남 모란의 작은 요가 스튜디오, 울림요가. 현재의 몸을 이해하고 나에게 필요한 움직임과 쉼을 찾아가는 요가와 사운드배스 클래스를 운영합니다.',
} = Astro.props;
const publicOrigin = 'https://ullimyoga.com';
const canonicalURL = new URL(Astro.url.pathname, publicOrigin).href;
// Dedicated studio illustration preview on warm ivory.
// Enable image metadata only when the real asset exists, never a broken URL.
const ogImagePath = '/images/og/ullim-yoga-og.png';
const hasOgImage = existsSync(resolve('public', ogImagePath.slice(1)));
const ogImageURL = new URL(ogImagePath, publicOrigin).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsActivityLocation'],
  name: '울림요가',
  alternateName: 'Ullim Yoga',
  description,
  url: 'https://ullimyoga.com',
  image: hasOgImage ? ogImageURL : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '둔촌대로113번길 8',
    addressLocality: '성남시 중원구',
    addressRegion: '경기도',
    addressCountry: 'KR',
  },
  sameAs: [
    'https://www.instagram.com/ullim.yoga/',
  ],
  knowsAbout: [
    'Yoga',
    'Sound Bath',
    'Movement',
    'Recovery',
  ],
};

---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <meta name="theme-color" content="#FAF6E6" />
    <script is:inline>
      // Restore only an explicit choice from this tab, before the first paint.
      try {
        if (sessionStorage.getItem('ullim-theme') === 'night') {
          document.documentElement.dataset.theme = 'night';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#211F1E');
        }
      } catch { /* Default to day when storage is unavailable. */ }
    </script>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {hasOgImage && <>
      <meta property="og:image" content={ogImageURL} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="울림요가 스튜디오 건물 일러스트" />
      <meta name="twitter:image" content={ogImageURL} />
      <meta name="twitter:image:alt" content="울림요가 스튜디오 건물 일러스트" />
    </>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <slot />
  </body>
</html>
