<style is:global>
  /* Conceal only dynamic promotion content until the runtime has synchronized it. */
  [data-promotion-pending] { visibility: hidden; }
  [data-promotion-only][hidden],
  [data-promotion-svg][hidden],
  [data-regular-discount][hidden] { display: none !important; }
</style>
<script>
  import { startPromotionRuntime } from '../lib/promotion-runtime.js';
  // Vite removes this branch from production builds, including astro preview.
  if (import.meta.env.DEV) {
    const { getPreviewClock } = await import('../lib/promotion-preview.js');
    startPromotionRuntime(document, window, getPreviewClock(window.location));
  } else {
    startPromotionRuntime();
  }
</script>
