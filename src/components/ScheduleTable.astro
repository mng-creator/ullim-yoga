---
import { days, schedule, scheduleTimes } from '../data/schedule';

const getClass = (day: string, time: string) =>
  schedule.find((item) => item.day === day && item.time === time);

const scheduleByDay = days.map((day) => ({
  ...day,
  classes: schedule
    .filter((item) => item.day === day.key)
    .sort((a, b) => a.time.localeCompare(b.time)),
}));

const isSoundBath = (className: string) =>
  className === '사운드배스';
---

<section class="schedule-section" aria-labelledby="schedule-title">

  <!-- SCHEDULE TITLE -->
  <div class="schedule-heading">
    <h1 id="schedule-title" lang="en">SCHEDULE</h1>
  </div>


  <!-- DESKTOP SCHEDULE -->
  <div class="schedule-desktop">

    <div class="schedule-grid schedule-header" aria-hidden="true">
      <div class="time-heading">TIME</div>

      {days.map((day) => (
        <div class="day-heading">{day.label}</div>
      ))}
    </div>

    {scheduleTimes.map((time) => (
      <div class="schedule-grid schedule-row">

        <div class="time-cell">{time}</div>

        {days.map((day) => {
          const item = getClass(day.key, time);

          return (
            <div class="class-cell">
              {item && (
                <span
                  class:list={[
                    'class-pill',
                    isSoundBath(item.className)
                      ? 'sound-bath'
                      : 'yoga',
                  ]}
                >
                  {item.className}
                </span>
              )}
            </div>
          );
        })}

      </div>
    ))}

  </div>


  <!-- MOBILE SCHEDULE -->
  <div class="schedule-mobile">

    {scheduleByDay.map((day) => (
      <section class="mobile-day">

        <h2 lang="en">{day.label}</h2>

        {day.classes.length > 0 ? (

          <div class="mobile-classes">

            {day.classes.map((item) => (
              <div class="mobile-class">

                <time datetime={item.time}>
                  {item.time}
                </time>

                <span
                  class:list={[
                    'class-pill',
                    isSoundBath(item.className)
                      ? 'sound-bath'
                      : 'yoga',
                  ]}
                >
                  {item.className}
                </span>

              </div>
            ))}

          </div>

        ) : (

          <p class="no-class" lang="en">
            NO CLASS
          </p>

        )}

      </section>
    ))}

  </div>


  <!-- LEGEND -->
  <div class="schedule-legend" aria-label="수업 구분">

    <div class="legend-item">
      <span
        class="legend-color yoga-color"
        aria-hidden="true"
      ></span>

      <span lang="en">YOGA</span>
    </div>

    <div class="legend-item">
      <span
        class="legend-color sound-color"
        aria-hidden="true"
      ></span>

      <span lang="en">SOUND BATH</span>
    </div>

  </div>


  <!-- CLASS GUIDE -->
  <section
    class="class-guide"
    aria-labelledby="class-guide-title"
  >

    <h2 id="class-guide-title" lang="en">
      CLASS GUIDE
    </h2>

    <div class="class-guide-list">

      <article class="class-guide-item">
        <h3 lang="en">HATHA</h3>

        <p>
          기본 아사나의 정렬과 호흡을 익히며,
          한 자세에 머물러 안정적인 움직임의 기본을 쌓습니다.
        </p>
      </article>


      <article class="class-guide-item">
        <h3 lang="en">THERAPY</h3>

        <p>
          도구를 활용해 필요한 부위를 세심하게 이완하고,
          몸의 긴장을 덜어 편안한 움직임과 회복을 돕습니다.
        </p>
      </article>


      <article class="class-guide-item">
        <h3 lang="en">SOMA</h3>

        <p>
          천천히 움직이며 몸의 섬세한 감각을 알아차리고,
          나에게 편안한 움직임을 찾아갑니다.
        </p>
      </article>


      <article class="class-guide-item">
        <h3 lang="en">AROMA</h3>

        <p>
          아로마의 향과 호흡에 집중하며 몸과 마음의 감각을
          차분히 알아차리고, 깊은 이완을 경험합니다.
        </p>
      </article>


      <article class="class-guide-item">
        <h3 lang="en">SINGING BOWL YOGA</h3>

        <p>
          아사나와 호흡에 싱잉볼의 소리와 울림을 더해,
          움직임과 머무름에 깊이 집중합니다.
        </p>
      </article>


      <article class="class-guide-item">
        <h3 lang="en">SOUND BATH</h3>

        <p>
          편안히 누워 싱잉볼의 소리와 울림을 들으며,
          움직임 없이 충분히 쉬고 이완합니다.
        </p>
      </article>

    </div>

  </section>


  <!-- NOTES -->
  <div class="schedule-note">
    <p>수업 일정은 스튜디오 운영 상황에 따라 변경될 수 있습니다.</p>
    <p>사운드배스는 예약제로 운영합니다.</p>
  </div>


  <!-- ACTIONS -->
  <div class="schedule-actions">

    <a
      href="https://www.instagram.com/ullim.yoga/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="action-text">
        <strong>수업 문의하기</strong>
        <small lang="en">INSTAGRAM DM</small>
      </span>

      <span class="action-arrow" aria-hidden="true">
        ↗
      </span>
    </a>


    <a
      href="https://naver.me/5HyBanCi"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="action-text">
        <strong>수업 예약하기</strong>
        <small lang="en">NAVER</small>
      </span>

      <span class="action-arrow" aria-hidden="true">
        ↗
      </span>
    </a>

  </div>

</section>


<style>

/* ========================================
   PAGE
======================================== */

.schedule-section {
  width: min(
    calc(100% - (var(--page-gutter) * 2)),
    780px
  );

  margin-inline: auto;

  padding:
    clamp(150px, 18vh, 220px)
    0
    clamp(100px, 12vh, 160px);

  color: var(--color-ink);
}


/* ========================================
   SCHEDULE TITLE
======================================== */

.schedule-heading {
  margin-bottom: clamp(56px, 7vw, 96px);
}

.schedule-heading h1 {
  margin: 0;

  font-family: var(--font-mono);
  font-size: clamp(22px, 4vw, 28px);
  font-weight: 600;
  line-height: 1;
  letter-spacing: .04em;
}


/* ========================================
   DESKTOP SCHEDULE
======================================== */

.schedule-desktop {
  width: 100%;
  border-top: 2px solid currentColor;
}

.schedule-grid {
  display: grid;

  grid-template-columns:
    minmax(72px, .7fr)
    repeat(7, 1fr);
}

.schedule-header {
  min-height: 64px;

  border-bottom:
    1px solid
    color-mix(
      in srgb,
      currentColor 55%,
      transparent
    );
}

.schedule-row {
  min-height: 62px;
}

.time-heading,
.day-heading,
.time-cell,
.class-cell {
  display: flex;
  align-items: center;
}

.time-heading,
.day-heading {
  justify-content: center;

  font-family: var(--font-mono);
  font-size: clamp(13px, 2.4vw, 16px);
  font-weight: 500;
  letter-spacing: .04em;
}

.time-cell {
  justify-content: center;

  font-family: var(--font-mono);
  font-size: clamp(13px, 2.4vw, 16px);
  font-weight: 500;
  letter-spacing: .04em;
}

.class-cell {
  justify-content: center;
  padding: 9px 4px;
}


/* ========================================
   CLASS PILLS
======================================== */

.class-pill {
  display: inline-flex;

  width: auto;
  min-width: 72px;
  min-height: 36px;

  align-items: center;
  justify-content: center;

  padding: 6px 14px;

  border-radius: 6px;

  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.2;

  white-space: nowrap;
}

.class-pill.yoga {
  background: #632F3E;
  color: #FAF6E6;
}

.class-pill.sound-bath {
  background: #DBF2AC;
  color: #632F3E;
}


/* ========================================
   LEGEND
======================================== */

.schedule-legend {
  display: flex;
  align-items: center;
  gap: 28px;

  /* 시간표와 범례 사이 구분선 */
  margin-top: 28px;
  padding-top: 28px;
  border-top: 1px solid currentColor;

  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .08em;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.legend-color {
  display: block;

  width: 12px;
  height: 12px;

  border-radius: 3px;
}

.yoga-color {
  background: #632F3E;
}

.sound-color {
  background: #DBF2AC;
}


/* ========================================
   CLASS GUIDE
======================================== */

.class-guide {
  margin-top: 112px;
}

.class-guide > h2 {
  margin: 0 0 56px;

  font-family: var(--font-mono);
  font-size: clamp(22px, 4vw, 28px);
  font-weight: 600;
  line-height: 1;
  letter-spacing: .04em;
}

.class-guide-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 34px;
}

.class-guide-item h3 {
  margin: 0 0 16px;

  font-family: var(--font-mono);
  font-size: clamp(13px, 2.4vw, 16px);
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: .04em;
}

.class-guide-item p {
  margin: 0;

  color: var(--color-muted);

  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 400;
  line-height: 1.75;

  word-break: keep-all;
}


/* ========================================
   NOTES
======================================== */

.schedule-note {
  display: grid;
  gap: 6px;

  margin-top: 56px;

  color: var(--color-muted);

  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
}

.schedule-note p {
  position: relative;

  margin: 0;
  padding-left: 13px;
}

.schedule-note p::before {
  content: "•";

  position: absolute;
  left: 0;
  top: 0;
}


/* ========================================
   ACTIONS
======================================== */

.schedule-actions {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  width: 100%;

  margin-top: 56px;

  border-top: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
}

.schedule-actions a {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 24px;

  min-width: 0;
  min-height: 112px;

  padding: 24px 28px;

  color: var(--color-ink);

  text-decoration: none;
}

.schedule-actions a + a {
  border-left: 1px solid currentColor;
}

.action-text {
  display: flex;

  flex-direction: column;
  align-items: flex-start;

  gap: 8px;
}

.action-text strong {
  display: block;

  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.3;
}

.action-text small {
  display: block;

  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 400;
  line-height: 1;

  letter-spacing: .08em;
}

.action-arrow {
  flex: 0 0 auto;

  margin-left: 20px;

  font-family: var(--font-mono);
  font-size: 18px;
  line-height: 1;
}

.schedule-actions a:hover {
  background:
    color-mix(
      in srgb,
      currentColor 5%,
      transparent
    );
}


/* ========================================
   MOBILE
======================================== */

.schedule-mobile {
  display: none;
}


@media (max-width: 800px) {

  .schedule-section {
    width:
      calc(
        100% -
        (var(--page-gutter) * 2)
      );

    padding:
      130px
      0
      90px;
  }


  /* TITLE */

  .schedule-heading {
    margin-bottom: 56px;
  }

  .schedule-heading h1 {
    font-size: 22px;
  }


  /* SCHEDULE */

  .schedule-desktop {
    display: none;
  }

  .schedule-mobile {
    display: block;

    border-top:
      2px solid
      currentColor;
  }

  .mobile-day {
    display: grid;

    grid-template-columns:
      64px
      1fr;

    gap: 18px;

    padding:
      24px
      0;

    border-bottom:
      1px solid
      color-mix(
        in srgb,
        currentColor 40%,
        transparent
      );
  }

  .mobile-day h2 {
    margin:
      5px
      0
      0;

    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;

    letter-spacing: .08em;
  }

  .mobile-classes {
    display: grid;
    gap: 9px;
  }

  .mobile-class {
    display: grid;

    grid-template-columns:
      54px
      minmax(0, 1fr);

    align-items: center;

    gap: 12px;
  }

  .mobile-class time {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .mobile-class .class-pill {
    width: 100%;
    max-width: none;

    min-height: 40px;
  }

  .no-class {
    margin:
      5px
      0
      0;

    color: var(--color-muted);

    font-family: var(--font-mono);
    font-size: 10px;

    letter-spacing: .08em;
  }


  /* LEGEND */

  .schedule-legend {
    flex-wrap: wrap;

    gap:
      12px
      24px;

    margin-top: 20px;
  }


  /* CLASS GUIDE */

  .class-guide {
    margin-top: 80px;
  }

  .class-guide > h2 {
    margin-bottom: 44px;

    font-size: 22px;
  }

  .class-guide-list {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .class-guide-item h3 {
    margin: 0 0 14px;

    font-size: 14px;
  }

  .class-guide-item p {
    font-size: 15px;
    line-height: 1.75;
  }


  /* NOTES */

  .schedule-note {
    margin-top: 48px;

    font-size: 12px;
  }


  /* ACTIONS */

  .schedule-actions {
    grid-template-columns: 1fr;

    margin-top: 40px;
  }

  .schedule-actions a {
    min-height: 88px;

    padding:
      20px
      18px;
  }

  .schedule-actions a + a {
    border-left: 0;
    border-top: 1px solid currentColor;
  }

  .action-text strong {
    font-size: 15px;
  }

  .action-text small {
    font-size: 10px;
  }

  .action-arrow {
    font-size: 17px;
  }

}

</style>