---
// Filenames match the supplied Soft Open assets, including case.
const artwork = { label: 'Soft Open', desktop: '/svg/Soft-Open-hor.svg', mobile: '/svg/Soft-Open-ver.svg', width: 500, height: 113, mobileWidth: 310, mobileHeight: 218 };
---
<section class="hero" aria-label={artwork.label}>
  <div class="hero-art page-shell">
    <h1>
      <span class="sr-only">울림요가 | 성남 모란 요가·사운드배스</span>
      <picture>
        <source media="(max-width: 700px)" srcset={artwork.mobile} width={artwork.mobileWidth} height={artwork.mobileHeight} />
        <img class="hero-title-art" data-keep-svg-color src={artwork.desktop} width={artwork.width} height={artwork.height} alt={artwork.label} fetchpriority="high" />
      </picture>
    </h1>
    <div class="studio-drawing">
      <img class="studio-svg" data-day-src="/svg/Ullim%20Yoga%20Studio.svg" data-night-src="/svg/Ullim%20Yoga%20Studio-night.svg" src="/svg/Ullim%20Yoga%20Studio.svg" width="990" height="381" alt="울림요가 스튜디오 건물 일러스트" />
      <button class="sign-light" type="button" aria-label="야간 모드 켜기"></button>
      <span class="light-hint" aria-hidden="true">
        <span class="light-hint-text">CLICK</span>
        <span class="light-hint-arrow">↘</span>
      </span>
    </div>
  </div>
<div class="marquee" aria-label="Yoga, Breathe, Sound Bath, Move Gently, Tea, Take Your Time" lang="en">
  <div class="marquee-track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee-group">
        {Array.from(
          { length: 3 },
          () => ['YOGA', 'BREATHE', 'SOUND BATH', 'MOVE GENTLY', 'TEA', 'TAKE YOUR TIME']
        ).flat().map((item) => <span>{item}</span>)}
      </div>
    ))}
  </div>
</div></section>

<style>
  .hero { display: flex; flex-direction: column; padding-top: 76px; }
  .hero-art { display: flex; flex-direction: column; justify-content: flex-start; align-items: center; gap: clamp(28px, 5svh, 64px); padding-block: 0 clamp(96px, 13.6svh, 160px); }
  /* Keep the original canvas and painted-art placement after SVG trimming.
     Asset dimensions never size the layout. */
  h1 { width: min(88%, 1080px, 105svh); margin: 0; min-height: 0; aspect-ratio: 2135 / 665; display: grid; grid-template-rows: 31.0766% 62.5714% 1fr; }
  h1 picture { grid-row: 2; width: 99.1011%; height: 100%; min-height: 0; justify-self: center; }
  h1 img { width: 100%; height: 100%; object-fit: contain; }

  .studio-drawing { position: relative; width: min(54%, 580px, 67svh); }
  .studio-drawing > img { width: 100%; }
  /* Interactive warm glow positioned over the projecting Yoga sign. */
  .sign-light {
    position: absolute;
    left: 42.9%;
    top: 16%;
    width: clamp(34px, 6.5%, 44px);
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    z-index: 2;
  }

  .light-hint {
    position: absolute;
    left: 22%;
    top: -6%;
    display: flex;
    align-items: flex-end;
    gap: 5px;
    color: var(--color-ink);
    font: 400 9px/1.2 'Pretendard', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    letter-spacing: .08em;
    white-space: nowrap;
    pointer-events: none;
    opacity: .9;
  }

  .light-hint-arrow {
    display: inline-block;
    font-size: 15px;
    line-height: 1;
    transform: translateY(4px);
  }

  .sign-light::before {
    content: '';
    position: absolute;
    inset: -55%;
    border-radius: 50%;
    background:
      radial-gradient(
        ellipse,
        rgb(255 246 170 / .92) 0%,
        rgb(255 231 112 / .58) 28%,
        rgb(255 214 74 / .25) 48%,
        rgb(255 214 74 / .08) 64%,
        transparent 78%
      );
    filter: blur(4px);
    opacity: .62;
    transform: scale(.92);
    pointer-events: none;
    animation: sign-breathe 1.2s ease-in-out infinite;
  }

  :global(html[data-theme='night']) .sign-light::before {
    opacity: .82;
    filter: blur(3px);
  }

  @keyframes sign-breathe {
    0%, 100% {
      opacity: .42;
      transform: scale(.88);
    }
    50% {
      opacity: 1;
      transform: scale(1.28);
    }
  }

  .marquee { overflow: hidden; width: 100%; flex-shrink: 0; padding-block: 14px; border-block: 1px solid currentColor; color: var(--color-ink); }
  .marquee-track { display: flex; width: max-content; --item-gap: clamp(56px, 6vw, 100px); gap: var(--item-gap); animation: drift 180s linear infinite; }
  /* Both internal and inter-group spacing use the same gap; include half
     the track gap in the translation to advance exactly one group. */
  .marquee-group { display: flex; flex-shrink: 0; align-items: center; gap: var(--item-gap); font-size: 11px; line-height: 1.5; letter-spacing: .09em; white-space: nowrap; }
  @keyframes drift { to { transform: translateX(calc(-50% - var(--item-gap) / 2)); } }
  @media (max-width: 700px) {
    .hero { padding-top: 88px; }
    .hero-art { gap: clamp(40px, 7svh, 64px); padding-block: 0 clamp(48px, 8svh, 80px); }
    h1 { width: min(100%, 440px, 60svh); aspect-ratio: 1510 / 1035; grid-template-rows: 20.542% 65.1613% 1fr; }
    h1 picture { width: 98.729%; }
    .studio-drawing { width: min(92%, 380px, 65svh); }
  }
  @media (prefers-reduced-motion: reduce) { .marquee-track, .sign-light::before { animation: none; } }
</style>

<script>
  const signLight = document.querySelector<HTMLButtonElement>('.sign-light');
  const lightHint = document.querySelector<HTMLElement>('.light-hint-text');
  const root = document.documentElement;

  const syncTheme = () => {
    const night = root.dataset.theme === 'night';
    document.querySelectorAll<HTMLImageElement>('img[data-day-src][data-night-src]').forEach((img) => {
      const src = night ? img.dataset.nightSrc : img.dataset.daySrc;
      if (src && img.getAttribute('src') !== src) img.setAttribute('src', src);
    });

    signLight?.setAttribute(
      'aria-label',
      night ? '조명을 끄고 주간 모드로 돌아가기' : '조명을 켜고 야간 모드 보기'
    );

    if (lightHint) {
      lightHint.textContent = window.innerWidth <= 700 ? 'TAP' : 'CLICK';
    }

    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      night ? '#211F1E' : '#FAF6E6'
    );
  };
  syncTheme();
  new MutationObserver(syncTheme).observe(root, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  signLight?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'night' ? 'day' : 'night';
    try { sessionStorage.setItem('ullim-theme', root.dataset.theme); } catch { /* Storage may be unavailable; toggling still works. */ }
  });
</script>
