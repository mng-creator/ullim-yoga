---
// Change only this value when the Soft Open announcement is approved.
const closingState: 'coming-soon' | 'soft-open' = 'coming-soon';
const messages = {
  'coming-soon': {
    title: '곧 만나요.',
    details: ['9.21 상담 및 예약을 시작합니다.', '10월 정식 오픈 예정입니다.'],
  },
  'soft-open': {
    title: '상담 및 예약이 시작되었습니다.',
    details: ['소프트 오픈 기간에도 수업에 참여하실 수 있습니다.', '10월 정식 오픈 예정입니다.'],
  },
};
const message = messages[closingState];
---
<section class="closing-info page-shell" aria-labelledby="closing-title">
  <div class="closing-copy">
    <h2 id="closing-title">{message.title}</h2>
    <div class="closing-details">
      {message.details.map(detail => <p>{detail}</p>)}
    </div>
  </div>
</section>
<style>
  .closing-info { padding-block: clamp(40px, 5vw, 80px) 120px; }
  .closing-copy { width: 100%; margin-inline: auto; text-align: center; }
  h2 { margin: 0 0 32px; color: #000; font-size: clamp(32px, 3.2vw, 48px); font-weight: 400; line-height: 1.5; letter-spacing: -.035em; word-break: keep-all; }
  .closing-details { display: flex; justify-content: center; align-items: flex-start; gap: 10px; }
  p { flex: 0 1 auto; width: fit-content; max-width: 100%; margin: 0; padding: 8px 14px; background: var(--color-burgundy); color: var(--color-paper); font-size: 14px; line-height: 1.7; letter-spacing: -.02em; word-break: keep-all; text-wrap: pretty; }
  @media (max-width: 700px) {
    .closing-info { padding-bottom: 96px; }
    h2 { margin-bottom: 28px; font-size: 32px; }
    .closing-details { flex-direction: column; align-items: center; gap: 10px; }
    p { font-size: 13px; padding: 8px 12px; }
  }
</style>
