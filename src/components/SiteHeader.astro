    color-scheme: light;
  }
  #price-overlay::backdrop { background: #FAF6E6; }
  .price-close {
    position: fixed;
    z-index: 1;
    top: 32px;
    right: var(--page-gutter);
    border: 0;
    padding: 12px 0 12px 12px;
    background: #FAF6E6;
    color: inherit;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: .12em;
    cursor: pointer;
  }
  .price-artwork {
