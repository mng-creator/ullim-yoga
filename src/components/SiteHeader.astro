    letter-spacing: .12em;
    cursor: pointer;
  }
  nav {
    position: fixed;
    inset: 94px var(--page-gutter) auto auto;
    margin: 0;
    border: 0;
    padding: 24px;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  nav a, .price-toggle { display: block; padding-block: 12px; font-size: 12px; letter-spacing: .1em; text-underline-offset: 5px; }
  .price-toggle {
    border: 0;
    padding-inline: 0;
    background: none;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  #price-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
