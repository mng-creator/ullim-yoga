<header class="site-header">
  <a class="brand" href="/" aria-label="Ullim Yoga Studio 홈">
      <img class="theme-logo" data-day-src="/svg/logo-en-horizontal-black.svg" data-night-src="/svg/logo-en-horizontal-night.svg" src="/svg/logo-en-horizontal-black.svg" width="338" height="36" alt="Ullim Yoga Studio" />
  </a>
  <button class="menu-toggle" popovertarget="site-menu" lang="en">MENU</button>
</header>
<nav id="site-menu" popover aria-label="메인 메뉴">
    <a href="#about" lang="en">ABOUT</a>
    <a href="#classes" lang="en">CLASSES</a>
    <button class="price-toggle" type="button" aria-haspopup="dialog" aria-controls="price-overlay" lang="en">PRICE</button>
    <a href="#visit" lang="en">VISIT</a>
    <a href="mailto:ullimyoga@naver.com" lang="en">CONTACT</a>
</nav>

<dialog id="price-overlay" aria-label="울림요가 수강권 가격표">
  <button class="price-close" type="button" aria-label="가격표 닫기" lang="en" autofocus>CLOSE ×</button>
  <div class="price-artwork">
    <img src="/svg/class-passes.svg" data-keep-svg-color alt="울림요가 클래스 수강권 가격표" />
    <dl class="sr-only">
      <dt lang="en">Yoga Drop-in</dt>
      <dd>₩35,000</dd>
      <dt lang="en">Yoga 8-Class Pass</dt>
      <dd>₩240,000</dd>
      <dt lang="en">Yoga 12-Class Pass</dt>
      <dd>₩336,000</dd>
      <dt lang="en">Yoga 24-Class Pass</dt>
      <dd>₩600,000</dd>
      <dt lang="en">Yoga 36-Class Pass</dt>
      <dd>₩864,000</dd>
      <dt lang="en">Sound Bath Single Session</dt>
      <dd>₩30,000</dd>
    </dl>
    <section class="price-guide" aria-labelledby="price-guide-title">
      <h2 id="price-guide-title">이용 안내</h2>
      <ul>
        <li>Drop-in: 구매일로부터 14일 이내 사용</li>
        <li>8-Class Pass: 첫 수업일부터 6주</li>
        <li>12-Class Pass: 첫 수업일부터 8주</li>
        <li>24-Class Pass: 첫 수업일부터 16주</li>
        <li>36-Class Pass: 첫 수업일부터 24주, 1회 최대 4주 홀딩 가능</li>
        <li>클래스 패스는 구매 후 30일 이내 시작</li>
      </ul>
    </section>
  </div>
</dialog>

<script>
  const menu = document.querySelector<HTMLElement>('#site-menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.hidePopover();

      if (!link.hash) return;

      const target = document.querySelector<HTMLElement>(link.hash);
      target?.setAttribute('tabindex', '-1');
      target?.focus({ preventScroll: true });
    });
  });

  const priceToggle = document.querySelector<HTMLButtonElement>('.price-toggle');
  const priceOverlay = document.querySelector<HTMLDialogElement>('#price-overlay');
  const priceClose = document.querySelector<HTMLButtonElement>('.price-close');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  let scrollX = 0;
  let scrollY = 0;
  let bodyStyle = '';

  priceToggle?.addEventListener('click', () => {
    if (!priceOverlay || priceOverlay.open) return;

    scrollX = window.scrollX;
    scrollY = window.scrollY;
    bodyStyle = document.body.style.cssText;
    menu?.hidePopover();
    Object.assign(document.body.style, {
      position: 'fixed',
      top: `-${scrollY}px`,
      left: `-${scrollX}px`,
      width: '100%',
      overflow: 'hidden',
    });
    priceOverlay.showModal();
    priceOverlay.scrollTop = 0;
  });

  priceClose?.addEventListener('click', () => priceOverlay?.close());
  priceOverlay?.addEventListener('click', (event) => {
    if (event.target === priceOverlay ||
        (event.target instanceof HTMLElement && event.target.classList.contains('price-artwork'))) {
      priceOverlay.close();
    }
  });
  priceOverlay?.addEventListener('close', () => {
    document.body.style.cssText = bodyStyle;
    window.scrollTo({ left: scrollX, top: scrollY, behavior: 'instant' });
    menuToggle?.focus({ preventScroll: true });
  });
</script>

