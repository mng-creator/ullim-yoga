---
const photos = [
  { file: '1.png', alt: '따뜻한 조명 아래 울림요가의 벤치와 식물', shape: 'portrait' },
  { file: '3.png', alt: '선반에 가지런히 놓인 요가 매트', shape: 'small' },
  { file: '2.png', alt: '싱잉볼이 놓인 밝은 수련실', shape: 'wide' },
  { file: '4.png', alt: '커튼 옆 편안하게 쉬어갈 수 있는 의자', shape: 'low' },
  { file: 'ullimyoga-studio-night.png', alt: '밤에 조명이 켜진 울림요가 스튜디오 외관', shape: 'exterior', width: 2340, height: 1331 },
  { file: '5.png', alt: '해가 진 뒤 불이 켜진 울림요가 간판', shape: 'small' },
  { file: '7.png', alt: '작은 테이블 위 조명과 차 한 잔', shape: 'portrait' },
  { file: '6.png', alt: '건물 밖에서 바라본 요가 스튜디오 간판', shape: 'wide' },
];
---
<div class="photo-drift" tabindex="0" role="region" aria-label="울림요가 공간 사진, 좌우로 스크롤">
  <div class="photo-track">
    {[0, 1, 2].map((copy) => (
      <div class="photo-group" aria-hidden={copy !== 1 ? 'true' : undefined}>
        {photos.map(({ file, alt, shape, width = 2400, height = 3200 }) => (
          <img class={shape} src={`/images/space/${file}`} width={width} height={height} alt={copy !== 1 ? '' : alt} loading="lazy" decoding="async" draggable="false" />
        ))}
      </div>
    ))}
  </div>
</div>
<style>
  .photo-drift { width: 100%; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; cursor: grab; touch-action: pan-x pan-y; overscroll-behavior-x: contain; margin-bottom: 80px; --photo-unit: clamp(160px, 18vw, 290px); --photo-gap: clamp(32px, 5vw, 80px); }
  .photo-track { display: flex; width: max-content; user-select: none; }
  .photo-group { display: flex; flex: 0 0 auto; align-items: flex-start; gap: var(--photo-gap); padding-right: var(--photo-gap); padding-bottom: 12px; }
  .photo-group img { flex: 0 0 auto; width: var(--photo-unit); max-width: none; height: calc(var(--photo-unit) * 1.33); object-fit: cover; }
  .photo-group .small { width: calc(var(--photo-unit) * .64); height: calc(var(--photo-unit) * .86); margin-top: calc(var(--photo-unit) * .38); }
  .photo-group .wide { width: calc(var(--photo-unit) * 1.2); height: calc(var(--photo-unit) * .9); margin-top: calc(var(--photo-unit) * .16); }
  .photo-group .low { width: calc(var(--photo-unit) * .86); height: calc(var(--photo-unit) * 1.14); margin-top: calc(var(--photo-unit) * .46); }
  .photo-group .exterior { width: auto; height: calc(var(--photo-unit) * 1.14); aspect-ratio: 2340 / 1331; object-fit: contain; margin-top: calc(var(--photo-unit) * .22); }
  .photo-drift::-webkit-scrollbar { display: none; }
  .photo-drift.is-dragging { cursor: grabbing; }
  /* Float within the existing 12px bottom clearance; matching copies stay
     in phase so horizontal loop wrapping remains seamless. */
  @media (prefers-reduced-motion: no-preference) {
    .photo-group img { animation: photo-float 12s ease-in-out infinite; animation-delay: -3s; }
    .photo-group img:nth-child(2n) { --float-distance: 8px; animation-duration: 15s; animation-delay: -9s; }
    .photo-group img:nth-child(3n) { --float-distance: 6px; animation-duration: 17s; animation-delay: -5s; }
    .photo-group img:nth-child(4n) { --float-distance: 9px; animation-duration: 14s; animation-delay: -11s; }
  }
  @keyframes photo-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(var(--float-distance, 10px)); }
  }
  @media (max-width: 700px) { .photo-drift { --photo-unit: 170px; --photo-gap: 32px; } }

</style>

<script>
  const strip = document.querySelector<HTMLElement>('.photo-drift');
  if (strip) {
    const group = strip.querySelector<HTMLElement>('.photo-group')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let period = 0, frame = 0, lastTime = 0, resumeAt = 0, driftCarry = 0;
    let visible = false, active = false, mouseDrag = false;
    let lastX = 0, lastMove = 0, velocity = 0;
    const wrap = () => {
      if (!period) return;
      if (strip.scrollLeft < period * .5) strip.scrollLeft += period;
      else if (strip.scrollLeft > period * 1.5) strip.scrollLeft -= period;
    };
    const tick = (time: number) => {
      frame = 0;
      const dt = Math.min(time - (lastTime || time), 32);
      lastTime = time;
      if (!active && visible) {
        if (!reduced.matches && Math.abs(velocity) > .01) {
          strip.scrollLeft += velocity * dt;
          velocity *= Math.pow(.94, dt / 16.67);
        } else if (!reduced.matches && time > resumeAt) {
          // About 9px/s: clearly visible while remaining calm.
          driftCarry += dt * .009;
          if (driftCarry >= 1) { const pixels = Math.floor(driftCarry); strip.scrollLeft += pixels; driftCarry -= pixels; }
        }
        wrap();
      }
      if (visible && !reduced.matches) frame = requestAnimationFrame(tick);
    };
    const start = () => { if (!frame && visible && !reduced.matches) { lastTime = 0; frame = requestAnimationFrame(tick); } };
    const pause = () => { resumeAt = performance.now() + 8000; velocity = 0; };
    new ResizeObserver(() => {
      const next = group.getBoundingClientRect().width;
      const progress = period ? (strip.scrollLeft % period) / period : 0;
      period = next;
      strip.scrollLeft = period * (1 + progress);
    }).observe(group);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start(); else { cancelAnimationFrame(frame); frame = 0; }
    }).observe(strip);
    strip.addEventListener('scroll', wrap, { passive: true });
    strip.addEventListener('wheel', pause, { passive: true });
    strip.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || !event.isPrimary) return;
      pause(); active = true; mouseDrag = event.pointerType === 'mouse';
      lastX = event.clientX; lastMove = performance.now();
      if (mouseDrag) {
        strip.setPointerCapture(event.pointerId);
        strip.classList.add('is-dragging');
        event.preventDefault();
      }
    });
    strip.addEventListener('pointermove', (event) => {
      if (!active || !mouseDrag) return;
      const now = performance.now(), delta = lastX - event.clientX;
      strip.scrollLeft += delta;
      velocity = Math.max(-1.5, Math.min(1.5, delta / Math.max(8, now - lastMove)));
      lastX = event.clientX; lastMove = now; wrap();
    });
    const release = () => {
      if (!active) return;
      if (!mouseDrag || performance.now() - lastMove > 100 || reduced.matches) velocity = 0;
      active = false; mouseDrag = false;
      resumeAt = performance.now() + 8000;
      strip.classList.remove('is-dragging'); start();
    };
    strip.addEventListener('pointerup', release);
    strip.addEventListener('pointercancel', release);
    strip.addEventListener('lostpointercapture', release);
    strip.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault(); pause();
      strip.scrollLeft += (event.key === 'ArrowRight' ? 1 : -1) * 180; wrap();
    });
    reduced.addEventListener('change', () => {
      velocity = 0; cancelAnimationFrame(frame); frame = 0; start();
    });
  }
</script>
